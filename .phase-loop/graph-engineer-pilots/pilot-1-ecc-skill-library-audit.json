{
  "schema_version": "v1.1",
  "name": "ecc-skill-library-audit-pilot",
  "description": "Read-only pilot audit of the ECC skill-library graph package",
  "objective": "Produce one reviewed audit artifact without write-capable deployment authority",
  "success_criteria": [{"id": "review-pass", "metric": "review_result", "threshold": "pass", "evidence": ["review-report", "run-ledger"]}],
  "budget": {"max_model_calls": 8, "max_spawned_agents": 2, "max_concurrency": 2, "max_tool_calls": 12, "max_wall_clock_seconds": 300, "max_tokens": 12000, "max_retries": 2, "max_graph_writes": 2},
  "evidence_policy": {"required_anchors": true, "required_sources": true, "required_evaluator_outputs": true, "min_evidence_count": 1},
  "diagram": "Planner → Audit Worker → Reviewer → Synthesizer → Human Gate; failure → retry; exhaustion → Human Gate",
  "nodes": [
    {"id": "plan", "type": "planner", "responsibility": "Create the bounded ECC audit brief", "inputs": [], "outputs": ["brief.json"], "input_ports": [], "output_ports": [{"name": "brief", "schema": {"type": "object"}}]},
    {"id": "worker", "type": "worker", "responsibility": "Inspect the ECC skill-library package read-only", "inputs": ["plan"], "outputs": ["audit.json"], "loop_cap": 2, "input_ports": [{"name": "brief", "from_node": "plan", "from_port": "brief", "schema": {"type": "object"}}], "output_ports": [{"name": "audit", "schema": {"type": "object"}}], "resources": {"writes": ["pilot-1:audit.json"], "locks": ["pilot-1:audit.json"], "isolation": "isolated"}},
    {"id": "reviewer", "type": "reviewer", "responsibility": "Check whether the audit evidence is reproducible", "reviewed_node_id": "worker", "inputs": ["worker"], "outputs": ["review-report.json"], "review_questions": ["Is every audit conclusion supported by reproducible local evidence?"], "review_report_schema": "schemas/review-report.schema.json", "input_ports": [{"name": "audit", "from_node": "worker", "from_port": "audit", "schema": {"type": "object"}}], "output_ports": [{"name": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}]},
    {"id": "synthesizer", "type": "synthesizer", "responsibility": "Package the reviewed ECC audit artifact", "inputs": ["reviewer"], "outputs": ["final.json"], "input_ports": [{"name": "review", "from_node": "reviewer", "from_port": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}], "output_ports": [{"name": "final", "schema": {"type": "object"}}], "resources": {"writes": ["pilot-1:final.json"], "locks": ["pilot-1:final.json"], "isolation": "shared"}},
    {"id": "human-gate-publish", "type": "human-gate", "responsibility": "Approve the audit artifact for external publication", "inputs": ["synthesizer"], "outputs": ["approval.json"], "human_gate_action": "publish", "input_ports": [{"name": "final", "from_node": "synthesizer", "from_port": "final", "schema": {"type": "object"}}], "output_ports": [{"name": "approval", "schema": {"type": "object"}}]}
  ],
  "edges": [
    {"from": "plan", "to": "worker", "from_port": "brief", "to_port": "brief", "dependency_reason": "Worker needs the bounded audit brief", "type": "data"},
    {"from": "worker", "to": "reviewer", "from_port": "audit", "to_port": "audit", "dependency_reason": "Reviewer needs the audit artifact", "type": "data"},
    {"from": "reviewer", "to": "worker", "condition": "review_failed", "dependency_reason": "Failed review returns evidence feedback to the worker", "type": "failure"},
    {"from": "reviewer", "to": "synthesizer", "from_port": "review_report", "to_port": "review", "condition": "review_passed", "dependency_reason": "Synthesizer needs the passing review report", "type": "data"},
    {"from": "worker", "to": "human-gate-publish", "condition": "retry_exhausted", "dependency_reason": "Exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "synthesizer", "to": "human-gate-publish", "from_port": "final", "to_port": "final", "dependency_reason": "Human needs the final audit artifact", "type": "data"}
  ],
  "caps": {"max_review_rounds": 3, "max_spawned_agents": 2, "max_total_agents": 5},
  "human_gates": [{"position": "human-gate-publish", "action": "publish"}]
}
