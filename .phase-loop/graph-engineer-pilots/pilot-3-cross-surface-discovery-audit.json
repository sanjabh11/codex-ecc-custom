{
  "schema_version": "v1.1",
  "name": "cross-surface-discovery-audit-pilot",
  "description": "Audit pilot for physical discovery paths, logical hosts, and loader proof",
  "objective": "Produce a reviewed cross-surface discovery report without claiming host execution",
  "success_criteria": [{"id": "review-pass", "metric": "review_result", "threshold": "pass", "evidence": ["review-report", "surface-ledger"]}],
  "budget": {"max_model_calls": 8, "max_spawned_agents": 2, "max_concurrency": 2, "max_tool_calls": 12, "max_wall_clock_seconds": 300, "max_tokens": 12000, "max_retries": 2, "max_graph_writes": 2},
  "evidence_policy": {"required_anchors": true, "required_sources": true, "required_evaluator_outputs": true, "min_evidence_count": 1},
  "diagram": "Planner → Surface Worker → Reviewer → Synthesizer → Human Gate; failure → retry; exhaustion → Human Gate",
  "nodes": [
    {"id": "plan", "type": "planner", "responsibility": "Define the cross-surface discovery audit brief", "inputs": [], "outputs": ["brief.json"], "input_ports": [], "output_ports": [{"name": "brief", "schema": {"type": "object"}}]},
    {"id": "worker", "type": "worker", "responsibility": "Map physical paths to logical host families", "inputs": ["plan"], "outputs": ["surface-ledger.json"], "loop_cap": 2, "input_ports": [{"name": "brief", "from_node": "plan", "from_port": "brief", "schema": {"type": "object"}}], "output_ports": [{"name": "ledger", "schema": {"type": "object"}}], "resources": {"writes": ["pilot-3:surface-ledger.json"], "locks": ["pilot-3:surface-ledger.json"], "isolation": "isolated"}},
    {"id": "reviewer", "type": "reviewer", "responsibility": "Check whether discovery is separated from loader proof", "reviewed_node_id": "worker", "inputs": ["worker"], "outputs": ["review-report.json"], "review_questions": ["Does the surface ledger avoid treating symlink discovery as host runtime proof?"], "review_report_schema": "schemas/review-report.schema.json", "input_ports": [{"name": "ledger", "from_node": "worker", "from_port": "ledger", "schema": {"type": "object"}}], "output_ports": [{"name": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}]},
    {"id": "synthesizer", "type": "synthesizer", "responsibility": "Package the reviewed discovery report", "inputs": ["reviewer"], "outputs": ["final.json"], "input_ports": [{"name": "review", "from_node": "reviewer", "from_port": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}], "output_ports": [{"name": "final", "schema": {"type": "object"}}], "resources": {"writes": ["pilot-3:final.json"], "locks": ["pilot-3:final.json"], "isolation": "shared"}},
    {"id": "human-gate-publish", "type": "human-gate", "responsibility": "Approve the discovery report for sharing", "inputs": ["synthesizer"], "outputs": ["approval.json"], "human_gate_action": "publish", "input_ports": [{"name": "final", "from_node": "synthesizer", "from_port": "final", "schema": {"type": "object"}}], "output_ports": [{"name": "approval", "schema": {"type": "object"}}]}
  ],
  "edges": [
    {"from": "plan", "to": "worker", "from_port": "brief", "to_port": "brief", "dependency_reason": "Worker needs the bounded surface brief", "type": "data"},
    {"from": "worker", "to": "reviewer", "from_port": "ledger", "to_port": "ledger", "dependency_reason": "Reviewer needs the surface ledger", "type": "data"},
    {"from": "reviewer", "to": "worker", "condition": "review_failed", "dependency_reason": "Failed review returns proof-boundary feedback to the worker", "type": "failure"},
    {"from": "reviewer", "to": "synthesizer", "from_port": "review_report", "to_port": "review", "condition": "review_passed", "dependency_reason": "Synthesizer needs the passing review report", "type": "data"},
    {"from": "worker", "to": "human-gate-publish", "condition": "retry_exhausted", "dependency_reason": "Exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "synthesizer", "to": "human-gate-publish", "from_port": "final", "to_port": "final", "dependency_reason": "Human needs the final discovery report", "type": "data"}
  ],
  "caps": {"max_review_rounds": 3, "max_spawned_agents": 2, "max_total_agents": 5},
  "human_gates": [{"position": "human-gate-publish", "action": "publish"}]
}
