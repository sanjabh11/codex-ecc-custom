{
  "schema_version": "v1.1",
  "name": "pir-panjal-release-repair",
  "description": "Pir Panjal POC release-consumer repair graph: 4 pre-join workers (A/B/C/D), independent reviewers, explicit failure/exhaustion paths, human gate before promotion",
  "objective": "Repair the Pir Panjal POC release-consumer boundary to pass the strengthened cross-layer contract without weakening any gate",
  "success_criteria": [
    {"id": "all-workers-pass", "metric": "worker_pass_count", "threshold": "4", "evidence": ["worker-a-findings.json", "worker-b-findings.json", "worker-c-findings.json", "worker-d-findings.json"]},
    {"id": "all-reviews-pass", "metric": "review_pass_count", "threshold": "5", "evidence": ["r1a-review.json", "r1b-review.json", "r1c-review.json", "r1d-review.json", "r2-review.json"]},
    {"id": "focused-suite-green", "metric": "test_pass_count", "threshold": "all", "evidence": ["pytest-output.txt"]}
  ],
  "budget": {"max_model_calls": 20, "max_spawned_agents": 8, "max_concurrency": 4, "max_tool_calls": 40, "max_wall_clock_seconds": 3600, "max_tokens": 50000, "max_retries": 3, "max_graph_writes": 6},
  "evidence_policy": {"required_anchors": true, "required_sources": true, "required_evaluator_outputs": true, "min_evidence_count": 3},
  "diagram": "Planner → [Worker A (workflow contract) | Worker B (release consumer) | Worker C (Modal identity) | Worker D (decision-record loader)] → Join-1 → R1A/R1B/R1C/R1D → Join-2 → Worker E (forecast semantics) → R2 (semantic reviewer) → Synthesizer → Human Gate; all reviewer failures → retry (cap 3); all exhaustion → Human Gate",
  "nodes": [
    {"id": "planner", "type": "planner", "responsibility": "Decompose the Pir Panjal repair into 4 independent boundary tracks + 1 post-join semantic track", "inputs": [], "outputs": ["repair-brief.json"], "input_ports": [], "output_ports": [{"name": "brief", "schema": {"type": "object"}}]},
    {"id": "worker-a", "type": "worker", "responsibility": "Track A: verify workflow contract (POC derivation, registry/decision-record digests, producer flags)", "inputs": ["planner"], "outputs": ["worker-a-findings.json"], "loop_cap": 3, "input_ports": [{"name": "brief", "from_node": "planner", "from_port": "brief", "schema": {"type": "object"}}], "output_ports": [{"name": "findings", "schema": {"type": "object"}}], "resources": {"writes": ["pir-panjal:worker-a-findings.json"], "locks": ["pir-panjal:worker-a-findings.json"], "isolation": "isolated"}},
    {"id": "worker-b", "type": "worker", "responsibility": "Track B: verify release consumer (shared poc_scope_contract.py binding, decision record, result, manifest, forecast semantics)", "inputs": ["planner"], "outputs": ["worker-b-findings.json"], "loop_cap": 3, "input_ports": [{"name": "brief", "from_node": "planner", "from_port": "brief", "schema": {"type": "object"}}], "output_ports": [{"name": "findings", "schema": {"type": "object"}}], "resources": {"writes": ["pir-panjal:worker-b-findings.json"], "locks": ["pir-panjal:worker-b-findings.json"], "isolation": "isolated"}},
    {"id": "worker-c", "type": "worker", "responsibility": "Track C: verify Modal identity (independent run/compute IDs, submission/terminal fields, call_id validation)", "inputs": ["planner"], "outputs": ["worker-c-findings.json"], "loop_cap": 3, "input_ports": [{"name": "brief", "from_node": "planner", "from_port": "brief", "schema": {"type": "object"}}], "output_ports": [{"name": "findings", "schema": {"type": "object"}}], "resources": {"writes": ["pir-panjal:worker-c-findings.json"], "locks": ["pir-panjal:worker-c-findings.json"], "isolation": "isolated"}},
    {"id": "worker-d", "type": "worker", "responsibility": "Track D: verify decision-record loader (malformed UTF-8, controlled DecisionRecordError, hash binding)", "inputs": ["planner"], "outputs": ["worker-d-findings.json"], "loop_cap": 3, "input_ports": [{"name": "brief", "from_node": "planner", "from_port": "brief", "schema": {"type": "object"}}], "output_ports": [{"name": "findings", "schema": {"type": "object"}}], "resources": {"writes": ["pir-panjal:worker-d-findings.json"], "locks": ["pir-panjal:worker-d-findings.json"], "isolation": "isolated"}},
    {"id": "r1a", "type": "reviewer", "responsibility": "Review track A: is every workflow contract claim verified with source evidence?", "reviewed_node_id": "worker-a", "inputs": ["worker-a"], "outputs": ["r1a-review.json"], "review_questions": ["Is every workflow contract claim verified with source evidence?"], "review_report_schema": "schemas/review-report.schema.json", "input_ports": [{"name": "findings", "from_node": "worker-a", "from_port": "findings", "schema": {"type": "object"}}], "output_ports": [{"name": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}]},
    {"id": "r1b", "type": "reviewer", "responsibility": "Review track B: does the consumer gate bind all layers without fallback?", "reviewed_node_id": "worker-b", "inputs": ["worker-b"], "outputs": ["r1b-review.json"], "review_questions": ["Does the consumer gate bind decision record, result, manifest, and forecast without fallback?"], "review_report_schema": "schemas/review-report.schema.json", "input_ports": [{"name": "findings", "from_node": "worker-b", "from_port": "findings", "schema": {"type": "object"}}], "output_ports": [{"name": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}]},
    {"id": "r1c", "type": "reviewer", "responsibility": "Review track C: is the Modal URL identity boundary injection-safe?", "reviewed_node_id": "worker-c", "inputs": ["worker-c"], "outputs": ["r1c-review.json"], "review_questions": ["Are Modal call_id, run_id, compute_job_id, and route validated against path traversal, dot-only segments, and non-string types?"], "review_report_schema": "schemas/review-report.schema.json", "input_ports": [{"name": "findings", "from_node": "worker-c", "from_port": "findings", "schema": {"type": "object"}}], "output_ports": [{"name": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}]},
    {"id": "r1d", "type": "reviewer", "responsibility": "Review track D: does the loader convert all malformed inputs to controlled errors?", "reviewed_node_id": "worker-d", "inputs": ["worker-d"], "outputs": ["r1d-review.json"], "review_questions": ["Does the decision-record loader convert all malformed inputs to controlled DecisionRecordError?"], "review_report_schema": "schemas/review-report.schema.json", "input_ports": [{"name": "findings", "from_node": "worker-d", "from_port": "findings", "schema": {"type": "object"}}], "output_ports": [{"name": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}]},
    {"id": "worker-e", "type": "worker", "responsibility": "Track E (post-join): verify forecast semantics (horizon, ensemble, region, band binding across all layers)", "inputs": ["r1a", "r1b", "r1c", "r1d"], "outputs": ["worker-e-findings.json"], "loop_cap": 3, "input_ports": [{"name": "r1a_review", "from_node": "r1a", "from_port": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}, {"name": "r1b_review", "from_node": "r1b", "from_port": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}, {"name": "r1c_review", "from_node": "r1c", "from_port": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}, {"name": "r1d_review", "from_node": "r1d", "from_port": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}], "output_ports": [{"name": "findings", "schema": {"type": "object"}}], "resources": {"writes": ["pir-panjal:worker-e-findings.json"], "locks": ["pir-panjal:worker-e-findings.json"], "isolation": "isolated"}},
    {"id": "r2", "type": "reviewer", "responsibility": "Review track E: do all forecast scope fields match the decision record?", "reviewed_node_id": "worker-e", "inputs": ["worker-e"], "outputs": ["r2-review.json"], "review_questions": ["Are forecast horizon, ensemble, region, and band consistent across decision record, result, manifest, and forecast semantics?"], "review_report_schema": "schemas/review-report.schema.json", "input_ports": [{"name": "findings", "from_node": "worker-e", "from_port": "findings", "schema": {"type": "object"}}], "output_ports": [{"name": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}]},
    {"id": "synthesizer", "type": "synthesizer", "responsibility": "Merge all reviewed findings into a single repair report with evidence anchors", "inputs": ["r2"], "outputs": ["repair-report.json"], "input_ports": [{"name": "review", "from_node": "r2", "from_port": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}], "output_ports": [{"name": "report", "schema": {"type": "object"}}], "resources": {"writes": ["pir-panjal:repair-report.json"], "locks": ["pir-panjal:repair-report.json"], "isolation": "shared"}},
    {"id": "human-gate-promotion", "type": "human-gate", "responsibility": "Approve the repair for promotion — no native SNOWPACK, live Modal, or DGRE approval is implied", "inputs": ["synthesizer"], "outputs": ["approval.json"], "human_gate_action": "promote", "input_ports": [{"name": "report", "from_node": "synthesizer", "from_port": "report", "schema": {"type": "object"}}], "output_ports": [{"name": "approval", "schema": {"type": "object"}}]}
  ],
  "edges": [
    {"from": "planner", "to": "worker-a", "from_port": "brief", "to_port": "brief", "dependency_reason": "Worker A needs the repair brief to scope the workflow contract track", "type": "data"},
    {"from": "planner", "to": "worker-b", "from_port": "brief", "to_port": "brief", "dependency_reason": "Worker B needs the repair brief to scope the release consumer track", "type": "data"},
    {"from": "planner", "to": "worker-c", "from_port": "brief", "to_port": "brief", "dependency_reason": "Worker C needs the repair brief to scope the Modal identity track", "type": "data"},
    {"from": "planner", "to": "worker-d", "from_port": "brief", "to_port": "brief", "dependency_reason": "Worker D needs the repair brief to scope the decision-record loader track", "type": "data"},
    {"from": "worker-a", "to": "r1a", "from_port": "findings", "to_port": "findings", "dependency_reason": "R1A needs worker A findings to review the workflow contract track", "type": "data"},
    {"from": "worker-b", "to": "r1b", "from_port": "findings", "to_port": "findings", "dependency_reason": "R1B needs worker B findings to review the release consumer track", "type": "data"},
    {"from": "worker-c", "to": "r1c", "from_port": "findings", "to_port": "findings", "dependency_reason": "R1C needs worker C findings to review the Modal identity track", "type": "data"},
    {"from": "worker-d", "to": "r1d", "from_port": "findings", "to_port": "findings", "dependency_reason": "R1D needs worker D findings to review the decision-record loader track", "type": "data"},
    {"from": "r1a", "to": "worker-a", "condition": "review_failed", "dependency_reason": "Failed review returns feedback to worker A for retry", "type": "failure"},
    {"from": "r1b", "to": "worker-b", "condition": "review_failed", "dependency_reason": "Failed review returns feedback to worker B for retry", "type": "failure"},
    {"from": "r1c", "to": "worker-c", "condition": "review_failed", "dependency_reason": "Failed review returns feedback to worker C for retry", "type": "failure"},
    {"from": "r1d", "to": "worker-d", "condition": "review_failed", "dependency_reason": "Failed review returns feedback to worker D for retry", "type": "failure"},
    {"from": "r1a", "to": "worker-e", "from_port": "review_report", "to_port": "r1a_review", "condition": "review_passed", "dependency_reason": "Worker E needs the passing R1A review to proceed with post-join semantic verification", "type": "data"},
    {"from": "r1b", "to": "worker-e", "from_port": "review_report", "to_port": "r1b_review", "condition": "review_passed", "dependency_reason": "Worker E needs the passing R1B review to proceed with post-join semantic verification", "type": "data"},
    {"from": "r1c", "to": "worker-e", "from_port": "review_report", "to_port": "r1c_review", "condition": "review_passed", "dependency_reason": "Worker E needs the passing R1C review to proceed with post-join semantic verification", "type": "data"},
    {"from": "r1d", "to": "worker-e", "from_port": "review_report", "to_port": "r1d_review", "condition": "review_passed", "dependency_reason": "Worker E needs the passing R1D review to proceed with post-join semantic verification", "type": "data"},
    {"from": "worker-a", "to": "human-gate-promotion", "condition": "retry_exhausted", "dependency_reason": "Worker A exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "worker-b", "to": "human-gate-promotion", "condition": "retry_exhausted", "dependency_reason": "Worker B exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "worker-c", "to": "human-gate-promotion", "condition": "retry_exhausted", "dependency_reason": "Worker C exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "worker-d", "to": "human-gate-promotion", "condition": "retry_exhausted", "dependency_reason": "Worker D exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "worker-e", "to": "r2", "from_port": "findings", "to_port": "findings", "dependency_reason": "R2 needs worker E findings to review the post-join semantic track", "type": "data"},
    {"from": "r2", "to": "worker-e", "condition": "review_failed", "dependency_reason": "Failed review returns feedback to worker E for retry", "type": "failure"},
    {"from": "worker-e", "to": "human-gate-promotion", "condition": "retry_exhausted", "dependency_reason": "Worker E exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "r2", "to": "human-gate-promotion", "condition": "retry_exhausted", "dependency_reason": "R2 exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "r2", "to": "synthesizer", "from_port": "review_report", "to_port": "review", "condition": "review_passed", "dependency_reason": "Synthesizer needs the passing R2 review to package the repair report", "type": "data"},
    {"from": "synthesizer", "to": "human-gate-promotion", "from_port": "report", "to_port": "report", "dependency_reason": "Human needs the final repair report to decide on promotion", "type": "data"}
  ],
  "joins": [
    {"node_id": "worker-e", "expected_count": 4, "partial_failure": "block"}
  ],
  "caps": {"max_review_rounds": 3, "max_spawned_agents": 8, "max_total_agents": 20},
  "human_gates": [{"position": "human-gate-promotion", "action": "promote"}]
}
