{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecc.local/schemas/codex-action-optimization-manifest.v1.json",
  "title": "Codex action optimization manifest",
  "description": "Evidence-bound contracts for frequently observed Codex actions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "source_audit", "actions"],
  "properties": {
    "schema_version": {"const": "codex-action-optimization-manifest.v1"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "source_audit": {"$ref": "#/$defs/sourceAudit"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sourceAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_path", "summary_sha256", "window_start", "window_end"],
      "properties": {
        "summary_path": {"type": "string", "minLength": 1},
        "summary_sha256": {"$ref": "#/$defs/sha256"},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_clock_seconds", "max_tool_calls", "max_retries"],
      "properties": {
        "max_wall_clock_seconds": {"type": "integer", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "max_retries": {"type": "integer", "minimum": 0}
      }
    },
    "resultContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "success_definition", "failure_definition", "redaction_policy"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "success_definition": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "failure_definition": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "redaction_policy": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rank",
        "observed_count",
        "observed_session_count",
        "proof_level",
        "status",
        "owner",
        "objective",
        "preconditions",
        "result_contract",
        "stop_conditions",
        "budget",
        "manual_gate",
        "next_action"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "rank": {"type": "integer", "minimum": 1},
        "observed_count": {"type": "integer", "minimum": 0},
        "observed_session_count": {"type": "integer", "minimum": 0},
        "proof_level": {"const": "L2-top-level-tool-record"},
        "status": {"enum": ["pilot", "evidence", "defer"]},
        "owner": {"enum": ["architect", "glm", "manual", "external"]},
        "objective": {"type": "string", "minLength": 1},
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "result_contract": {"$ref": "#/$defs/resultContract"},
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "budget": {"$ref": "#/$defs/budget"},
        "manual_gate": {"type": "boolean"},
        "next_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
