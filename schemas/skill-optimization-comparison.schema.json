{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecc.local/schemas/skill-optimization-comparison.v1.json",
  "title": "Skill optimization before/after comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "skill_name",
    "target_path",
    "before_score",
    "after_score",
    "delta",
    "before_counts",
    "after_counts",
    "missing_baseline",
    "added_scenarios",
    "regressed",
    "newly_passing",
    "blocking_reasons",
    "decision"
  ],
  "properties": {
    "mode": {"const": "strict-improve"},
    "skill_name": {"type": "string", "minLength": 1},
    "target_path": {"type": "string", "minLength": 1},
    "before_score": {"type": "number", "minimum": 0, "maximum": 1},
    "after_score": {"type": "number", "minimum": 0, "maximum": 1},
    "delta": {"type": "number"},
    "before_counts": {"$ref": "#/$defs/counts"},
    "after_counts": {"$ref": "#/$defs/counts"},
    "missing_baseline": {"type": "array", "items": {"type": "string"}},
    "added_scenarios": {"type": "array", "items": {"type": "string"}},
    "regressed": {"type": "array", "items": {"type": "string"}},
    "newly_passing": {"type": "array", "items": {"type": "string"}},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "decision": {"enum": ["promote", "reject", "hold"]}
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "not_run", "total"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    }
  }
}
