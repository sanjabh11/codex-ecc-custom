{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecc.local/schemas/skill-package-validation.v1.json",
  "title": "Skill package validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "manifest_path", "validator_path", "validator_sha256", "summary", "results"],
  "properties": {
    "schema_version": {"const": "skill-package-validation.v1"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "manifest_path": {"type": "string", "minLength": 1},
    "validator_path": {"type": "string", "minLength": 1},
    "validator_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "timed_out"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "timed_out": {"type": "integer", "minimum": 0}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target_path", "target_sha256", "package_path", "status", "exit_code", "stdout", "stderr"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "target_path": {"type": "string", "minLength": 1},
          "target_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "package_path": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "timeout"]},
          "exit_code": {"type": ["integer", "null"]},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        }
      }
    }
  }
}
