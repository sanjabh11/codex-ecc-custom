{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advisor State",
  "description": "Persistent state for advisor call tracking",
  "type": "object",
  "required": ["call_count", "history"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "description": "State file schema version" },
    "call_count": { "type": "integer", "minimum": 0 },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["call", "context_preview", "response_preview", "timestamp"],
        "properties": {
          "call": { "type": "integer", "minimum": 1 },
          "context_preview": { "type": "string" },
          "response_preview": { "type": "string" },
          "timestamp": { "type": "string", "description": "ISO 8601 UTC" },
          "session_id": { "type": ["string", "null"], "description": "Optional session identifier" }
        }
      }
    },
    "session_id": { "type": ["string", "null"], "description": "Optional current session identifier" }
  }
}
