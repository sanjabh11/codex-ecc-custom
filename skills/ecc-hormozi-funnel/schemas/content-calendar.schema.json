{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hormozi Content Calendar",
  "description": "Schema for 30-day content calendars generated by the batching machine",
  "type": "object",
  "required": ["calendar_id", "audit_id", "pillars", "entries", "proof_density", "schema_version"],
  "properties": {
    "schema_version": { "const": "v8" },
    "calendar_id": { "type": "string", "pattern": "^CAL-\\d{3}$" },
    "audit_id": { "type": "string", "description": "Cites positioning audit ID" },
    "pillars": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["pillar_name", "subtopics"],
        "properties": {
          "pillar_name": { "type": "string" },
          "pillar_source": { "type": "string", "description": "Hypothesis ID from positioning audit" },
          "subtopics": {
            "type": "array",
            "minItems": 10,
            "items": { "type": "string" }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "pillar", "platform", "content_type", "title", "has_proof"],
        "properties": {
          "day": { "type": "integer", "minimum": 1, "maximum": 30 },
          "pillar": { "type": "string" },
          "platform": { "type": "string", "enum": ["twitter", "instagram", "tiktok", "linkedin", "youtube"] },
          "content_type": { "type": "string", "enum": ["thread", "carousel", "script", "post", "short", "long_form"] },
          "title": { "type": "string" },
          "body": { "type": "string", "description": "Full content text or script" },
          "has_proof": { "type": "boolean", "description": "True if content cites evidence from positioning audit" },
          "evidence_citations": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Evidence IDs cited in this content piece"
          },
          "hook_id": { "type": "string", "description": "Hook ID if a generated hook is used" },
          "char_count": { "type": "integer", "description": "Character count for platform limit compliance" }
        }
      }
    },
    "proof_density": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Fraction of entries with has_proof=true — must be >= 0.50"
    },
    "platform_distribution": {
      "type": "object",
      "properties": {
        "twitter": { "type": "integer" },
        "instagram": { "type": "integer" },
        "tiktok": { "type": "integer" },
        "linkedin": { "type": "integer" },
        "youtube": { "type": "integer" }
      }
    }
  }
}
