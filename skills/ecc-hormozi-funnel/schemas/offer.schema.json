{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hormozi Value Equation Offer",
  "description": "Schema for offers constructed using the Hormozi Value Equation framework",
  "type": "object",
  "required": ["offer_id", "segment_id", "pain_id", "dream_outcome", "value_equation_scores", "bonus_stack", "guarantee", "scarcity_urgency", "price", "total_value_stack", "evidence_citations", "schema_version"],
  "properties": {
    "schema_version": { "const": "v8" },
    "offer_id": { "type": "string", "pattern": "^OFF-\\d{3}$" },
    "segment_id": { "type": "string", "description": "Cites positioning audit segment ID" },
    "pain_id": { "type": "string", "description": "Cites positioning audit pain/hypothesis ID" },
    "dream_outcome": {
      "type": "object",
      "required": ["statement", "specificity_score"],
      "properties": {
        "statement": { "type": "string", "description": "Vivid, specific, emotional, identity-tied outcome" },
        "specificity_score": { "type": "integer", "minimum": 1, "maximum": 10 },
        "identity_anchor": { "type": "string", "description": "Who the customer becomes" },
        "time_bound": { "type": "string", "description": "When the outcome is achieved" }
      }
    },
    "value_equation_scores": {
      "type": "object",
      "required": ["dream_outcome", "likelihood", "time_delay", "effort_sacrifice", "composite"],
      "properties": {
        "dream_outcome": { "type": "integer", "minimum": 1, "maximum": 10 },
        "likelihood": { "type": "integer", "minimum": 1, "maximum": 10 },
        "time_delay": { "type": "integer", "minimum": 1, "maximum": 10, "description": "10 = fastest, 1 = slowest" },
        "effort_sacrifice": { "type": "integer", "minimum": 1, "maximum": 10, "description": "10 = least effort, 1 = most effort" },
        "composite": { "type": "number", "description": "(Dream x Likelihood) / ((11-Time) x (11-Effort)) x 10" }
      }
    },
    "bonus_stack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bonus_name", "solves", "dollar_value"],
        "properties": {
          "bonus_name": { "type": "string" },
          "solves": { "type": "string", "enum": ["speed", "effort", "likelihood", "adjacent"] },
          "dollar_value": { "type": "number", "minimum": 0 },
          "description": { "type": "string" }
        }
      }
    },
    "guarantee": {
      "type": "object",
      "required": ["type", "terms"],
      "properties": {
        "type": { "type": "string", "enum": ["unconditional", "conditional", "performance_based", "stacked", "anti_guarantee"] },
        "terms": { "type": "string" },
        "duration_days": { "type": "integer", "minimum": 0 }
      }
    },
    "scarcity_urgency": {
      "type": "object",
      "properties": {
        "scarcity_type": { "type": "string", "enum": ["cohort", "capacity", "bonus_based", "none"] },
        "scarcity_detail": { "type": "string" },
        "urgency_type": { "type": "string", "enum": ["deadline", "seasonal", "rolling", "none"] },
        "urgency_detail": { "type": "string" },
        "is_real": { "type": "boolean", "description": "Must be true — fake scarcity destroys trust" }
      }
    },
    "price": { "type": "number", "minimum": 0 },
    "total_value_stack": { "type": "number", "minimum": 0, "description": "Sum of all bonus dollar values plus core offer value" },
    "value_ratio": { "type": "number", "description": "total_value_stack / price — target 10x or higher" },
    "offer_name": { "type": "string", "description": "Named offer with identity" },
    "offer_presentation": {
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "core_offer_description": { "type": "string" },
        "bonus_descriptions": { "type": "array", "items": { "type": "string" } },
        "guarantee_statement": { "type": "string" },
        "cta": { "type": "string" }
      }
    },
    "evidence_citations": {
      "type": "array",
      "items": { "type": "string", "description": "Evidence IDs from positioning audit corpus" },
      "minItems": 1,
      "description": "Every offer claim must cite positioning audit evidence"
    },
    "rank": { "type": "integer", "minimum": 1, "description": "Rank among all constructed offers (1 = best)" },
    "rewrite_notes": { "type": "string", "description": "Notes from top-3 rewrite to make irresistible" }
  }
}
