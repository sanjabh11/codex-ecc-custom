{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-ecc-custom/skills/ecc-niche-positioning-audit/schemas/artifact.schema.json",
  "title": "Positioning Audit Phase Artifact",
  "description": "Machine-checkable schema for phase artifacts, replacing prose '4-page' format",
  "type": "object",
  "required": ["artifact_version", "phase", "run_id", "scope", "scores", "evidence", "recommendations", "confidence"],
  "properties": {
    "artifact_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "phase": {
      "type": "string",
      "enum": ["phase-0", "phase-1", "phase-2", "phase-3", "phase-4", "phase-5", "phase-6"]
    },
    "run_id": {
      "type": "string",
      "description": "Links to state.json run_id"
    },
    "scope": {
      "type": "string",
      "enum": ["quick", "standard", "deep"]
    },
    "scores": {
      "type": "array",
      "description": "Summary scores table (replaces Page 1)",
      "items": {
        "type": "object",
        "required": ["item", "score", "evidence_line"],
        "properties": {
          "item": {"type": "string"},
          "score": {
            "type": ["number", "string"],
            "description": "Numeric score or qualitative label"
          },
          "evidence_line": {"type": "string"},
          "evidence_grade": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Supporting evidence (replaces Page 3)",
      "items": {
        "type": "object",
        "required": ["finding", "sources"],
        "properties": {
          "finding": {"type": "string"},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "source_tier"],
              "properties": {
                "url": {"type": "string"},
                "title": {"type": "string"},
                "publication_date": {"type": "string"},
                "source_tier": {
                  "type": "string",
                  "enum": ["academic", "practitioner", "standard", "internal", "unverified"]
                },
                "bias_notes": {"type": "string"}
              }
            }
          },
          "negative_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "contradiction_status": {
            "type": "string",
            "enum": ["none", "found", "resolved"]
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Top recommendations (replaces Page 2)",
      "items": {
        "type": "object",
        "required": ["title", "owner", "surface", "due_date"],
        "properties": {
          "title": {"type": "string"},
          "owner": {"type": "string"},
          "surface": {"type": "string"},
          "due_date": {"type": "string"},
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "reversal_cost": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          },
          "closure_criteria": {"type": "string"},
          "post_remediation_test": {"type": "string"}
        }
      }
    },
    "comparison": {
      "type": "object",
      "description": "Comparison to previous run (replaces Page 4)",
      "properties": {
        "previous_run_id": {"type": "string"},
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {"type": "string"},
              "previous": {"type": ["number", "string"]},
              "current": {"type": ["number", "string"]},
              "delta": {"type": ["number", "string"]}
            }
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "description": "Confidence scorecard (mandatory on every artifact)",
      "required": ["composite", "subscores", "iterations", "final_score"],
      "properties": {
        "composite": {"type": "number", "minimum": 0, "maximum": 100},
        "subscores": {
          "type": "object",
          "properties": {
            "evidence_density": {"type": "number", "minimum": 0, "maximum": 100},
            "adversarial_survival": {"type": "number", "minimum": 0, "maximum": 100},
            "assumption_risk": {"type": "number", "minimum": 0, "maximum": 100},
            "coverage_completeness": {"type": "number", "minimum": 0, "maximum": 100},
            "triangulation_strength": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "iterations": {"type": "integer", "minimum": 1, "maximum": 3},
        "final_score": {"type": "number", "minimum": 0, "maximum": 100},
        "improvements_made": {"type": "string"}
      }
    },
    "adversarial_review": {
      "type": "object",
      "description": "Adversarial review notes (Phases 3, 4, 5)",
      "properties": {
        "skeptic": {
          "type": "object",
          "required": ["finding"],
          "properties": {
            "finding": {"type": "string"},
            "falsification_test": {"type": "string"}
          }
        },
        "missing_perspective": {
          "type": "object",
          "required": ["finding"],
          "properties": {
            "finding": {"type": "string"},
            "absent_perspective": {"type": "string"}
          }
        },
        "contrarian": {
          "type": "object",
          "required": ["finding"],
          "properties": {
            "finding": {"type": "string"},
            "alternative_conclusion": {"type": "string"}
          }
        }
      }
    },
    "gate_decision": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["GO", "CONDITIONAL_GO", "RECYCLE", "STOP"]
        },
        "conditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "pre_gate_self_assessment": {"type": "number", "minimum": 5, "maximum": 25}
      }
    }
  }
}
