{
  "test_name": "scope_dag_validity",
  "description": "Verify all 3 scopes have valid start-to-terminal paths",
  "cases": [
    {
      "scope": "quick",
      "expected_path": ["phase-0", "phase-1", "phase-2", "phase-4", "terminal"],
      "skipped_phases": ["phase-3", "phase-5", "phase-6"],
      "gate_threshold": 12
    },
    {
      "scope": "standard",
      "expected_path": ["phase-0", "phase-1", "phase-2", "phase-3", "phase-4", "approval", "phase-5", "phase-6", "terminal"],
      "skipped_phases": [],
      "gate_threshold": 15
    },
    {
      "scope": "deep",
      "expected_path": ["phase-0", "phase-1", "phase-2", "phase-3", "phase-4", "approval", "phase-5", "phase-6", "terminal"],
      "skipped_phases": [],
      "gate_threshold": 15
    }
  ],
  "expected": {
    "all_scopes_valid": true,
    "no_impossible_paths": true,
    "no_contradictions": true
  },
  "grader": "deterministic",
  "pass_threshold": 1.0
}
