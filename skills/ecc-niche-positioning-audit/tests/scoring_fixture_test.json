{
  "test_name": "scoring_reproducibility",
  "description": "Verify confidence score formula is deterministic and reproducible",
  "cases": [
    {
      "subscores": {
        "evidence_density": 85,
        "adversarial_survival": 75,
        "assumption_risk": 100,
        "coverage_completeness": 100,
        "triangulation_strength": 80
      },
      "expected_composite": 87.5,
      "formula": "(85*0.30) + (75*0.20) + (100*0.20) + (100*0.15) + (80*0.15)"
    },
    {
      "subscores": {
        "evidence_density": 50,
        "adversarial_survival": 60,
        "assumption_risk": 60,
        "coverage_completeness": 80,
        "triangulation_strength": 50
      },
      "expected_composite": 58.0,
      "formula": "(50*0.30) + (60*0.20) + (60*0.20) + (80*0.15) + (50*0.15)"
    },
    {
      "subscores": {
        "evidence_density": 0,
        "adversarial_survival": 0,
        "assumption_risk": 0,
        "coverage_completeness": 0,
        "triangulation_strength": 0
      },
      "expected_composite": 0,
      "expected_outcome": "insufficient_evidence",
      "formula": "all zeros triggers insufficient evidence"
    }
  ],
  "expected": {
    "scores_reproducible": true,
    "missing_data_handled": true,
    "insufficient_evidence_triggered": true
  },
  "grader": "deterministic",
  "pass_threshold": 1.0
}
