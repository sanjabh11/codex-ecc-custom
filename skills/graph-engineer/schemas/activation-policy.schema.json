{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Graph Engineer Activation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "logical_host_families", "discovery_surfaces", "trigger_phrases", "anti_trigger_phrases", "clarification_phrases"],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "logical_host_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "discovery_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "family": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^~/[^\\n]+$" }
        }
      }
    },
    "trigger_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "anti_trigger_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "clarification_phrases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
