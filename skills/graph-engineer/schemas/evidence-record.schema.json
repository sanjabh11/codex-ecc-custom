{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Graph Engineer Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "graph_sha256", "timestamp", "event_type", "status", "attempt"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "graph_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": ["run_started", "node_attempt", "review", "gate_decision", "run_finished", "run_aborted"]
    },
    "node_id": { "type": ["string", "null"], "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["started", "pass", "fail", "retry", "skip", "finished", "aborted"]
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "artifact": { "type": ["string", "null"] },
    "artifact_digest": { "type": ["string", "null"] },
    "source": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 }
    },
    "evaluator": { "type": ["string", "null"] },
    "runtime_decision": { "type": ["string", "null"], "enum": ["available", "degraded", "blocked", "revoked", null] },
    "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
    "tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "model": { "type": ["string", "null"] },
    "approval_binding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["run_id", "graph_sha256", "artifact_digest", "action", "target", "approver", "decision", "approved_at", "expires_at"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "graph_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "artifact_digest": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["approved", "rejected", "aborted"] },
        "approved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "note": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "enum": ["node_attempt", "review", "gate_decision"] } } },
      "then": { "required": ["node_id"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "run_started" } } },
      "then": { "properties": { "status": { "const": "started" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "run_finished" } } },
      "then": { "properties": { "status": { "const": "finished" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "run_aborted" } } },
      "then": { "properties": { "status": { "const": "aborted" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "gate_decision" } } },
      "then": {
        "required": ["approval_binding"],
        "properties": {
          "status": { "enum": ["pass", "fail", "aborted"] },
          "approval_binding": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "review" } } },
      "then": { "properties": { "status": { "enum": ["pass", "fail", "retry"] } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "node_attempt" } } },
      "then": { "properties": { "status": { "enum": ["started", "pass", "fail", "retry", "skip"] } } }
    }
  ]
}
