{
  "schema_version": "v1.1",
  "name": "typed-v11-smoke-graph",
  "description": "A typed graph with explicit review, retry exhaustion, evidence, and approval boundaries",
  "objective": "Produce one reviewed artifact without exceeding the declared execution budget",
  "success_criteria": [
    {
      "id": "review-pass",
      "metric": "review_result",
      "threshold": "pass",
      "evidence": ["review-report", "run-ledger"]
    }
  ],
  "budget": {
    "max_model_calls": 8,
    "max_spawned_agents": 2,
    "max_concurrency": 2,
    "max_tool_calls": 12,
    "max_wall_clock_seconds": 300,
    "max_tokens": 12000,
    "max_retries": 2,
    "max_graph_writes": 3
  },
  "evidence_policy": {
    "required_anchors": true,
    "required_sources": true,
    "required_evaluator_outputs": true,
    "min_evidence_count": 1
  },
  "diagram": "Planner → Worker → Reviewer → Synthesizer → Human Gate; Reviewer failure → Worker; Worker exhaustion → Human Gate",
  "nodes": [
    {
      "id": "plan",
      "type": "planner",
      "responsibility": "Create the bounded task brief",
      "inputs": [],
      "outputs": ["brief.json"],
      "input_ports": [],
      "output_ports": [{"name": "brief", "schema": {"type": "object"}}]
    },
    {
      "id": "worker",
      "type": "worker",
      "responsibility": "Produce the candidate artifact",
      "inputs": ["plan"],
      "outputs": ["result.json"],
      "loop_cap": 2,
      "input_ports": [{"name": "brief", "from_node": "plan", "from_port": "brief", "schema": {"type": "object"}}],
      "output_ports": [{"name": "result", "schema": {"type": "object"}}],
      "resources": {"writes": ["artifact:v11/result.json"], "locks": ["artifact:v11/result.json"], "isolation": "isolated"}
    },
    {
      "id": "reviewer",
      "type": "reviewer",
      "responsibility": "Check the candidate artifact against the acceptance criterion",
      "reviewed_node_id": "worker",
      "inputs": ["worker"],
      "outputs": ["review-report.json"],
      "review_questions": ["Does the candidate satisfy the declared acceptance criterion?"] ,
      "review_report_schema": "schemas/review-report.schema.json",
      "input_ports": [{"name": "result", "from_node": "worker", "from_port": "result", "schema": {"type": "object"}}],
      "output_ports": [{"name": "review_report", "schema": {"$ref": "schemas/review-report.schema.json"}}]
    },
    {
      "id": "synthesizer",
      "type": "synthesizer",
      "responsibility": "Package the reviewed artifact for approval",
      "inputs": ["reviewer"],
      "outputs": ["final.json"],
      "input_ports": [{"name": "review", "from_node": "reviewer", "from_port": "review_report", "schema": {"type": "object"}}],
      "output_ports": [{"name": "final", "schema": {"type": "object"}}],
      "resources": {"writes": ["artifact:v11/final.json"], "locks": ["artifact:v11/final.json"], "isolation": "shared"}
    },
    {
      "id": "human-gate-publish",
      "type": "human-gate",
      "responsibility": "Approve the final artifact before publishing",
      "inputs": ["synthesizer"],
      "outputs": ["approval.json"],
      "human_gate_action": "publish",
      "input_ports": [{"name": "final", "from_node": "synthesizer", "from_port": "final", "schema": {"type": "object"}}],
      "output_ports": [{"name": "approval", "schema": {"type": "object"}}]
    }
  ],
  "edges": [
    {"from": "plan", "to": "worker", "from_port": "brief", "to_port": "brief", "dependency_reason": "Worker needs the bounded brief", "type": "data"},
    {"from": "worker", "to": "reviewer", "from_port": "result", "to_port": "result", "dependency_reason": "Reviewer needs the candidate artifact", "type": "data"},
    {"from": "reviewer", "to": "worker", "condition": "review_failed", "dependency_reason": "Failed review returns structured feedback to the reviewed worker", "type": "failure"},
    {"from": "reviewer", "to": "synthesizer", "from_port": "review_report", "to_port": "review", "condition": "review_passed", "dependency_reason": "Synthesizer needs the review report before approval", "type": "data"},
    {"from": "worker", "to": "human-gate-publish", "condition": "retry_exhausted", "dependency_reason": "Retry exhaustion requires human disposition", "type": "exhaustion"},
    {"from": "synthesizer", "to": "human-gate-publish", "from_port": "final", "to_port": "final", "dependency_reason": "Human needs the final artifact to approve publication", "type": "data"}
  ],
  "caps": {"max_review_rounds": 3, "max_spawned_agents": 2, "max_total_agents": 5},
  "human_gates": [{"position": "human-gate-publish", "action": "publish"}]
}
